FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY scripts/pattern_layout_entrypoint.sh ./scripts/pattern_layout_entrypoint.sh
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
RUN chmod +x scripts/pattern_layout_entrypoint.sh
ENTRYPOINT ["./scripts/pattern_layout_entrypoint.sh"]
