# Offline preparation only. Every blank must be explicitly selected/reviewed.
# Never pass this to deploy-projector.sh (that script remains local-review only).
PROJECTOR_ENABLED=0
PROJECTOR_BIND_ADDRESS=127.0.0.1
PROJECTOR_BIND_PORT=8092
# Required immutable registry reference: registry/repository@sha256:<64 hex>.
# Build/distribution and base provenance remain future authorized manual work.
PROJECTOR_IMAGE=
PROJECTOR_REDIS_IMAGE=
PROJECTOR_POLICY_FILE=
PROJECTOR_WX_BACKEND_URL=
# Plan-only origin for gateway/TLS review; not consumed by current compose/app.
PROJECTOR_PUBLIC_BASE_URL=
# Keep only in private input file; preparation never copies or prints it.
PROJECTOR_SERVICE_TOKEN=
PROJECTOR_HTTP_THREADS=
PROJECTOR_HTTP_TIMEOUT=
PROJECTOR_API_MEMORY=
PROJECTOR_API_CPUS=
PROJECTOR_API_PIDS=
PROJECTOR_WORKER_MEMORY=
PROJECTOR_WORKER_CPUS=
PROJECTOR_WORKER_PIDS=
PROJECTOR_REDIS_MAXMEMORY=
PROJECTOR_REDIS_MEMORY=
PROJECTOR_REDIS_CPUS=
PROJECTOR_REDIS_PIDS=
