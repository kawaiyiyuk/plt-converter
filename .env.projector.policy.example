# 用户于2026-10-14批准的产品 policy；应用仍要求显式文件配置，不读取本示例作默认。
# 源额度40MiB不等于全部disk，global包括multipart/meta/state/job/PNG等。
# upload是固定UTC minute窗口；tile token bucket 3/second，burst5。
PROJECTOR_OWNER_MAX_DOCUMENTS=2
PROJECTOR_OWNER_SOURCE_BYTES=41943040
PROJECTOR_GLOBAL_DISK_BYTES=2147483648
PROJECTOR_FREE_FLOOR_BYTES=2147483648
PROJECTOR_UPLOAD_OWNER_RATE=5
PROJECTOR_UPLOAD_IP_RATE=30
PROJECTOR_TILE_RATE=3
PROJECTOR_TILE_BURST=5
# 下列工程值是AI仅本地验证预算，尚不是已批准的生产policy：
PROJECTOR_OWNER_RENDERERS=1
PROJECTOR_GLOBAL_RENDERERS=2
PROJECTOR_GLOBAL_PARSERS=1
PROJECTOR_PARSE_WALL_SECONDS=90
PROJECTOR_TILE_WALL_SECONDS=30
PROJECTOR_CHILD_CPU_SECONDS=30
PROJECTOR_CHILD_MEMORY_BYTES=536870912

# AI 自行添加的 PLT 临时派生保护；独立于20MiB源上传/40MiB源额度。
# 同账号仍仅一个active纸样；128MiB覆盖被替换但尚未回收的派生/解析重叠。
PROJECTOR_DERIVED_MAX_BYTES=67108864
PROJECTOR_OWNER_DERIVED_BYTES=134217728
