# AI 建议 / 待确认: only non-production engineering verification budgets.
# This file does not enable projection and supplies no product policy defaults.
PROJECTOR_ENABLED=0
# Optional exact connection peers; blank ignores forwarding headers. Verify before use.
PROJECTOR_TRUSTED_PROXY_CIDRS=
PROJECTOR_IMAGE=fengrenjiyi-projector:local-review-candidate
PROJECTOR_BASE_ID=sha256:60ac62f0cd72b32f5914385cf7ab299f1987b2dc8960b98e34574bbdd1557fc3
PROJECTOR_BASE_IMAGE=localhost:1/fengrenjiyi-projector-base:review-60ac62f0cd72-CHANGE-TO-UNIQUE-UUID
# Must exist locally; never implicitly pull. Future production: approved registry digest.
PROJECTOR_REDIS_IMAGE=redis:7-alpine
PROJECTOR_POLICY_FILE=/private/tmp/projector-policy.review.env
PROJECTOR_BUILD_CONTEXT=/private/tmp/projector-build.review
# 真机局域网联调：改为本机私网 IP（小程序开发环境地址为 http://DEV_HOST:8092）；只允许 127.0.0.1 或 RFC1918 私网地址。
PROJECTOR_BIND_ADDRESS=127.0.0.1
PROJECTOR_BIND_PORT=8092
PROJECTOR_WX_BACKEND_URL=http://host.docker.internal:5001
PROJECTOR_HTTP_THREADS=8
PROJECTOR_HTTP_TIMEOUT=120
# 2GiB容器上限留父Gunicorn/8threads/结果body余量；不是实占预留或生产值。
PROJECTOR_API_MEMORY=2g
PROJECTOR_API_CPUS=1.0
PROJECTOR_API_PIDS=64
PROJECTOR_WORKER_MEMORY=1g
PROJECTOR_WORKER_CPUS=1.0
PROJECTOR_WORKER_PIDS=32
PROJECTOR_REDIS_MAXMEMORY=64mb
PROJECTOR_REDIS_MEMORY=128m
PROJECTOR_REDIS_CPUS=0.25
PROJECTOR_REDIS_PIDS=32
